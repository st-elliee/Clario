# ---- Database (MySQL 8) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clario
DB_USER=clario_user
DB_PASSWORD=change-me
# Only for hosted MySQL that requires SSL (e.g. Aiven): paste the CA certificate
# DB_CA_CERT="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"

# ---- Security ----
# Fernet key for encrypting ΑΦΜ / ΑΜΚΑ / Taxis credentials. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Secret for signing JWT login tokens (any long random string)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Web ----
# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Folder for uploaded client documents (default: backend/uploads)
# UPLOAD_DIR=

# ---- Live demo only ----
DEMO_MODE=false
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/reset-demo
# CRON_SECRET=
